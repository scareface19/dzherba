# =================================================================
# DZHERBA - FICHIER DE CONFIGURATION D'ENVIRONNEMENT (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. SERVEUR & APPLICATION
# -----------------------------------------------------------------
# Sur Render, PORT est injecté automatiquement (ex: 10000). Ne modifiez pas sur Render.
PORT=8080
NODE_ENV=production

# -----------------------------------------------------------------
# 2. INTELLIGENCE ARTIFICIELLE & RAG BOTANIQUE (Optionnel)
# -----------------------------------------------------------------
# Si renseignée, l'assistant IA utilise le modèle Gemini connecté au corpus de 773 plantes.
# Obtenez une clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative OpenAI (optionnelle)
# OPENAI_API_KEY=

# -----------------------------------------------------------------
# 3. BASE DE DONNÉES (SQLITE PAR DÉFAUT - AUCUNE CONFIG NÉCESSAIRE)
# -----------------------------------------------------------------
# DzHerba utilise nativement une base SQLite embarquée (data/dzherba.db).
# Zéro configuration, 100% autonome et optimisé pour le Cloud (Render) et le local.
# Le chemin par défaut est data/dzherba.db.
# SQLITE_DB_PATH=data/dzherba.db
