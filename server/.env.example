# =================================================================
# DZHERBA SERVER - FICHIER D'ENVIRONNEMENT (.env)
# =================================================================

PORT=8080
NODE_ENV=production

# Clé API Google Gemini pour le RAG IA (Optionnel)
GEMINI_API_KEY=

# Base de données MySQL (Optionnel sur Cloud / Render, obligatoire sur XAMPP local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dzherba_db
