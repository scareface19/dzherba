# =================================================================
# DZHERBA - FICHIER DE CONFIGURATION D'ENVIRONNEMENT (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. SERVEUR & APPLICATION
# -----------------------------------------------------------------
# Sur Render, PORT est injecté automatiquement (ex: 10000). Ne modifiez pas sur Render.
PORT=8080
NODE_ENV=production

# -----------------------------------------------------------------
# 2. INTELLIGENCE ARTIFICIELLE & RAG BOTANIQUE (Optionnel)
# -----------------------------------------------------------------
# Si renseignée, l'assistant IA utilise le modèle Gemini connecté au corpus de 773 plantes.
# Obtenez une clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative OpenAI (optionnelle)
# OPENAI_API_KEY=

# -----------------------------------------------------------------
# 3. BASE DE DONNÉES MYSQL CLOUD (Optionnel)
# -----------------------------------------------------------------
# DzHerba fonctionne en mode AUTONOME par défaut (773 plantes en mémoire sans MySQL).
# Si vous souhaitez persister les comptes utilisateurs dans une base MySQL Cloud
# (ex: Aiven.io, TiDB Cloud, Clever Cloud, PlanetScale, etc.), renseignez ces variables :
# DB_HOST=your-mysql-host.cloud.com
# DB_PORT=3306
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_NAME=dzherba_db
